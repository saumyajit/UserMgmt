{
    "manifest_version": 2.0,
    "id": "usermgmt",
    "name": "User Management in Zabbix",
    "version": "1.2",
    "author": "Saumyajit Pramanik",
    "namespace": "UserMgmt",
    "url": "https://www.zabbix.com/",
    "description": "Identify inactive Zabbix accounts and manage their lifecycle against a configurable policy.",
    "actions": {
        "user.policy": {
            "class": "UserPolicy",
            "view": "user.policy",
            "layout": "layout.htmlpage"
        },
        "user.policy.execute": {
            "class": "UserPolicyExecute",
            "layout": "layout.json"
        }
    }
}
