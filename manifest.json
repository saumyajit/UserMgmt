{
    "manifest_version": 2.0,
    "id": "usermgmt",
    "name": "User Management in Zabbix",
    "version": "1.1.4",
    "author": "Saumyajit Pramanik",
    "namespace": "UserMgmt",
    "url": "https://www.zabbix.com/",
    "description": "Managing users in Zabbix effectively",
    "actions": {
        "user.policy": {
            "class": "UserPolicy",
            "view": "user.policy",
            "layout": "layout.htmlpage"
        },
        "user.policy.execute": {
            "class": "UserPolicyExecute"
        },
        "user.policy.config": {
            "class": "UserPolicyConfig"
        }
    }
}
